[Desktop Entry]
Type=Application
Name=Vauchi
GenericName=Contact Card Manager
Comment=Privacy-focused updatable contact cards via in-person exchange
Exec=gvauchi %u
Icon=app.vauchi.Vauchi
Terminal=false
Categories=Network;ContactManagement;GTK;
Keywords=contacts;privacy;encrypted;exchange;qr;
StartupWMClass=app.vauchi.Vauchi
StartupNotify=true
DBusActivatable=true
X-GNOME-UsesNotifications=true
MimeType=x-scheme-handler/vauchi;
